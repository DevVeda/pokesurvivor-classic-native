# Copia este archivo a .env y rellénalo. .env no se sube a git.

# --- Firebase (Configuración del proyecto → Tus apps → app web) ---
# No son secretos (van en la web), pero se dejan aquí para las pruebas.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
FIREBASE_PROJECT_ID=tu-proyecto
FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_DATABASE_URL=https://tu-proyecto-default-rtdb.europe-west1.firebasedatabase.app

# --- Juego (tools/apply-env.mjs → js/env.js; todo esto lo ve el navegador) ---
# Dominios donde se publica el juego, separados por comas (localhost ya va incluido)
SITE_HOSTS=tu-proyecto.pages.dev
# Dominio inventado para el email interno de las cuentas por apodo. NO cambiarlo después.
NAME_DOMAIN=jugadores.tu-juego.invalid
# uid de las cuentas de moderación (Authentication → Usuarios), separados por comas
ADMIN_UIDS=
# Opcional: carpeta con live.json / aviso.json / video.json (vacío = sin avisos de directo)
LIVE_BASE=

# --- Actualizaciones firmadas (docs/updates.md; just publish) ---
# Clave privada Ed25519 (PKCS8 en base64). SECRETA: sólo la usa tools/sign-update.mjs; al juego va su pública.
# Crearla una vez (la añade aquí sin mostrarla) y guardar copia fuera del repo; si se pierde, no hay migración automática:
#   node -e "const k=require('crypto').generateKeyPairSync('ed25519').privateKey;console.log('UPDATE_SIGN_KEY='+k.export({type:'pkcs8',format:'der'}).toString('base64'))" >> .env
# Vacía: el build sale sin autoactualización.
UPDATE_SIGN_KEY=
# Sólo la pública (para compilar sin la privada, p. ej. en la CI de las releases): la «key» de update de tu js/env.js.
# UPDATE_PUBLIC_KEY=
# Quién publica (sólo para mostrar; la identidad es la clave)
UPDATE_AUTHOR=
# Dónde se publica, en orden (la 1.ª la principal; el resto, espejos). Vacío: <LIVE_BASE>/update/
UPDATE_URLS=

# Opcional: «Entrar con Google» en el juego de escritorio (macOS, Windows, Linux).
# Google Cloud → APIs y servicios → Credenciales → Crear ID de cliente OAuth → «App de escritorio» (mismo proyecto que
# Firebase). Luego, en Firebase → Authentication → Google: añadir este ID en «ID de clientes de proyectos externos».
GOOGLE_DESKTOP_CLIENT_ID=
GOOGLE_DESKTOP_CLIENT_SECRET=
# Opcional: «Entrar con Google» en las consolas (PS5, Switch), con QR y código: otro ID de cliente OAuth, tipo
# «TVs y dispositivos de entrada limitada» (mismo proyecto), y también en «ID de clientes de proyectos externos».
GOOGLE_TV_CLIENT_ID=
GOOGLE_TV_CLIENT_SECRET=

# Cuenta de prueba (correo/contraseña) para probar las conexiones. Que no sea tu cuenta real.
TEST_EMAIL=
TEST_PASSWORD=

# --- App Check (más adelante) ---
RECAPTCHA_SITE_KEY=

# --- Cloudflare (servidor que sustituye a ice.pokesurvivor.com) ---
CF_ACCOUNT_ID=
# Realtime → TURN Server → crear clave
TURN_KEY_ID=
TURN_KEY_API_TOKEN=
# Dirección del Worker cuando exista (vacío = sin TURN, sello del ranking ni salas por WebSocket), p. ej. https://pokesurvivor-ice.tu-cuenta.workers.dev
ICE_URL=
