@@ -185,7 +185,11 @@
 			addr_unmap_inet6_v4mapped((struct sockaddr *)&src->addr, &src->len);
 
 		} else if (sockerrno == SECONNRESET || sockerrno == SENETRESET ||
-		           sockerrno == SECONNREFUSED) {
+		           sockerrno == SECONNREFUSED || sockerrno == SEHOSTUNREACH ||
+		           sockerrno == SENETUNREACH) {
+			// (PokeSurvivor) macOS and Linux report an ICMP host/network unreachable (e.g. a STUN server over IPv6
